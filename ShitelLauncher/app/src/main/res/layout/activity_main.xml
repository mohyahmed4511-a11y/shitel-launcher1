<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="1dp"
        android:background="#00BCD4"
        android:gravity="center"
        android:orientation="vertical">
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="yyyy/MM/dd EEEE"
            android:format24Hour="yyyy/MM/dd EEEE"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btn_phone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/bg_red"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:drawableTop="@drawable/ic_phone"
            android:drawablePadding="4dp"
            android:text="Phone"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/btn_sms"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/bg_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:drawableTop="@drawable/ic_sms"
            android:drawablePadding="4dp"
            android:text="SMS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btn_calc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/bg_blue"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:drawableTop="@drawable/ic_calc"
            android:drawablePadding="4dp"
            android:text="Calculator"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/btn_calendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/bg_orange"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:drawableTop="@drawable/ic_calendar"
            android:drawablePadding="4dp"
            android:text="Calendar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
